                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                            <!-- Caminar -->
                            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                                <h5 class="font-bold text-slate-900 mb-1">
                                    <span lang="es">a) Caminar (Cross-paseo)</span>
                                    <span lang="en">a) Walking (Cross-walk)</span>
                                </h5>
                                <p class="text-xs text-slate-600 mb-3">
                                    <span lang="es">Andar a paso ligero o combinar marcha lenta/rápida. Ideal para personas sedentarias o con sobrepeso. Activación básica aeróbica.</span>
                                    <span lang="en">Brisk walking or combining slow/fast walking. Ideal for sedentary or overweight people. Basic aerobic activation.</span>
                                </p>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-[10px]">
                                    <div class="bg-blue-50 text-blue-800 p-2 rounded"><strong class="block"><span lang="es">Volumen</span><span lang="en">Volume</span></strong> <span lang="es">No menos de 30'</span><span lang="en">Not less than 30'</span></div>
                                    <div class="bg-red-50 text-red-800 p-2 rounded"><strong class="block"><span lang="es">Intensidad</span><span lang="en">Intensity</span></strong> 100-130 <span lang="es">ppm</span><span lang="en">bpm</span></div>
                                    <div class="bg-emerald-50 text-emerald-800 p-2 rounded"><strong class="block"><span lang="es">Recuperación</span><span lang="en">Recovery</span></strong> <span lang="es">No existe</span><span lang="en">None</span></div>
