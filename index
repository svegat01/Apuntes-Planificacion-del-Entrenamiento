                    if(b === btn && !b.classList.contains('active')) {
                        b.classList.remove('bg-slate-100', 'text-slate-600');
                        b.classList.add('active', 'bg-slate-900', 'text-white');
                    }
                });

                const filterValue = btn.getAttribute('data-filter');

                exerciseCards.forEach(card => {
                    if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // 4. Calculator Logic (Tanaka & Karvonen)
        const btnCalculate = document.getElementById('btnCalculate');
        
        btnCalculate.addEventListener('click', () => {
            const age = parseInt(document.getElementById('calcAge').value);
            const hrRest = parseInt(document.getElementById('calcHrRest').value);
            
            if (!age || age <= 0 || !hrRest || hrRest <= 0) {
                const msg = currentLang === 'es' 
                    ? "Por favor, introduce una edad y FC en reposo válidas." 
                    : "Please enter a valid Age and Resting HR.";
                alert(msg);
                return;
            }

            const hrMax = Math.round(208 - (0.7 * age));
            const hrReserve = hrMax - hrRest;
            const measureUnit = currentLang === 'es' ? "ppm" : "bpm";

            document.getElementById('resHrMax').innerText = hrMax;

            const calcZone = (percentObj) => Math.round((hrReserve * percentObj) + hrRest);

            document.getElementById('resZ1').innerText = `${calcZone(0.50)} - ${calcZone(0.60)} ${measureUnit}`;
            document.getElementById('resZ2').innerText = `${calcZone(0.60)} - ${calcZone(0.70)} ${measureUnit}`;
            document.getElementById('resZ3').innerText = `${calcZone(0.70)} - ${calcZone(0.80)} ${measureUnit}`;
            document.getElementById('resZ4').innerText = `${calcZone(0.80)} - ${calcZone(0.90)} ${measureUnit}`;
            document.getElementById('resZ5').innerText = `${calcZone(0.90)} - ${hrMax} ${measureUnit}`;
        });

        // 5. Copy Editable Prompt Logic
        const btnCopyPrompt = document.getElementById('btnCopyPrompt');
        const promptCodeBlock = document.getElementById('promptCodeBlock');

        btnCopyPrompt.addEventListener('click', () => {
            // Using .value captures any changes the student made in the textarea
            navigator.clipboard.writeText(promptCodeBlock.value).then(() => {
                const originalText = btnCopyPrompt.innerHTML;
                const successText = currentLang === 'es' ? "¡Copiado!" : "Copied!";
                btnCopyPrompt.innerHTML = `<i class="fa-solid fa-check"></i> ${successText}`;
                btnCopyPrompt.classList.remove('bg-brand-500');
                btnCopyPrompt.classList.add('bg-emerald-500');
                
                setTimeout(() => {
                    btnCopyPrompt.innerHTML = originalText;
                    btnCopyPrompt.classList.remove('bg-emerald-500');
                    btnCopyPrompt.classList.add('bg-brand-500');
                }, 2500);
            });
        });
    </script>
</body>
</html>
